<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>mx.gob.sidi</groupId>
    <artifactId>credencialessm</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>CredencialesSM</name>
    <description>Estación de credenciales de empleados SMSEM (JavaFX 21)</description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <javafx.version>21.0.2</javafx.version>
        <javafx.platform>linux</javafx.platform>
        <!-- El empaquetado deja solo el nativo de este sistema. El otro se quita. -->
        <opencv.otro.sistema>nu/pattern/opencv/windows/**</opencv.otro.sistema>
        <serial.otro.sistema>Windows/**</serial.otro.sistema>
        <hid.otro.sistema>win32-*/**</hid.otro.sistema>
    </properties>

    <dependencies>
        <dependency>
            <groupId>mx.gob.sidi</groupId>
            <artifactId>sidid</artifactId>
            <version>0.1.0-SNAPSHOT</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/sidid.jar</systemPath>
        </dependency>
        <!-- Link-OS PC-Card 3.01.263. No está en Maven Central; Zebra lo publica suelto. -->
        <dependency>
            <groupId>com.zebra</groupId>
            <artifactId>ZSDK_CARD_API</artifactId>
            <version>3.01.263</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/zebra/ZSDK_CARD_API.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.zebra</groupId>
            <artifactId>ZSDK_API</artifactId>
            <version>3.01.263</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/zebra/ZSDK_API.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>org.usb4java</groupId>
            <artifactId>usb4java</artifactId>
            <version>1.3.0</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/zebra/usb4java-1.3.0.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>org.usb4java</groupId>
            <artifactId>libusb4java</artifactId>
            <version>1.3.0</version>
            <classifier>linux-x86-64</classifier>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/zebra/libusb4java-1.3.0-linux-x86-64.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-base</artifactId>
            <version>${javafx.version}</version>
            <classifier>${javafx.platform}</classifier>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-graphics</artifactId>
            <version>${javafx.version}</version>
            <classifier>${javafx.platform}</classifier>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
            <classifier>${javafx.platform}</classifier>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-swing</artifactId>
            <version>${javafx.version}</version>
            <classifier>${javafx.platform}</classifier>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.17.1</version>
        </dependency>
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>core</artifactId>
            <version>3.5.3</version>
        </dependency>
        <dependency>
            <groupId>org.openpnp</groupId>
            <artifactId>opencv</artifactId>
            <version>4.9.0-0</version>
        </dependency>
        <dependency>
            <groupId>com.fazecast</groupId>
            <artifactId>jSerialComm</artifactId>
            <version>2.11.0</version>
        </dependency>
        <dependency>
            <groupId>org.hid4java</groupId>
            <artifactId>hid4java</artifactId>
            <version>0.8.0</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <release>${java.version}</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>incluir-sidid</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <unzip src="${project.basedir}/lib/sidid.jar" dest="${project.build.outputDirectory}" overwrite="true">
                                    <patternset>
                                        <!-- Cámara, pad, tema y el adaptador ZXP. El resto de sidid no lo usa la estación. -->
                                        <include name="mx/gob/sidi/desk/devices/**"/>
                                        <include name="mx/gob/sidi/desk/app/ui/CameraCaptureDialog*.class"/>
                                        <include name="mx/gob/sidi/desk/app/ui/SignatureCaptureDialog*.class"/>
                                        <include name="mx/gob/sidi/desk/app/ui/UiTheme.class"/>
                                        <include name="mx/gob/sidi/desk/app/ui/UiDialogs.class"/>
                                        <include name="ui/sididesk.css"/>
                                        <include name="card-layout.properties"/>
                                    </patternset>
                                </unzip>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                                <filter>
                                    <artifact>org.openpnp:opencv</artifact>
                                    <excludes>
                                        <exclude>nu/pattern/opencv/osx/**</exclude>
                                        <exclude>nu/pattern/opencv/linux/ARMv7/**</exclude>
                                        <exclude>nu/pattern/opencv/linux/ARMv8/**</exclude>
                                        <exclude>nu/pattern/opencv/linux/x86_32/**</exclude>
                                        <exclude>nu/pattern/opencv/windows/x86_32/**</exclude>
                                        <exclude>${opencv.otro.sistema}</exclude>
                                    </excludes>
                                </filter>
                                <filter>
                                    <artifact>com.fazecast:jSerialComm</artifact>
                                    <excludes>
                                        <exclude>OSX/**</exclude>
                                        <exclude>Solaris/**</exclude>
                                        <exclude>FreeBSD/**</exclude>
                                        <exclude>OpenBSD/**</exclude>
                                        <exclude>Android/**</exclude>
                                        <exclude>Linux/arm*/**</exclude>
                                        <exclude>Linux/ppc64le/**</exclude>
                                        <exclude>Linux/x86/**</exclude>
                                        <exclude>Windows/x86/**</exclude>
                                        <exclude>Windows/arm*/**</exclude>
                                        <exclude>Windows/aarch64/**</exclude>
                                        <exclude>${serial.otro.sistema}</exclude>
                                    </excludes>
                                </filter>
                                <filter>
                                    <artifact>org.hid4java:hid4java</artifact>
                                    <excludes>
                                        <exclude>darwin-*/**</exclude>
                                        <exclude>linux-arm/**</exclude>
                                        <exclude>linux-arm*/**</exclude>
                                        <exclude>linux-aarch64/**</exclude>
                                        <exclude>linux-riscv64/**</exclude>
                                        <exclude>linux-x86/**</exclude>
                                        <exclude>${hid.otro.sistema}</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>mx.org.smsem.credencialessm.CredencialesMain</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>mx.org.smsem.credencialessm.CredencialesMain</mainClass>
                    <launcher>CredencialesSM</launcher>
                    <jlinkImageName>credencialessm-runtime</jlinkImageName>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>javafx-windows</id>
            <activation>
                <os><family>windows</family></os>
            </activation>
            <properties>
                <javafx.platform>win</javafx.platform>
                <opencv.otro.sistema>nu/pattern/opencv/linux/**</opencv.otro.sistema>
                <serial.otro.sistema>Linux/**</serial.otro.sistema>
                <hid.otro.sistema>linux-*/**</hid.otro.sistema>
            </properties>
        </profile>
        <profile>
            <id>javafx-mac</id>
            <activation>
                <os><family>mac</family></os>
            </activation>
            <properties>
                <javafx.platform>mac</javafx.platform>
            </properties>
        </profile>
    </profiles>
</project>
