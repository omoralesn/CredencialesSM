<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>mx.gob.sidi</groupId>
    <artifactId>credencialessm</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>CredencialesSM</name>
    <description>Estación de credenciales de empleados SMSEM (JavaFX 21)</description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <javafx.version>21.0.2</javafx.version>
        <javafx.platform>linux</javafx.platform>
        <!-- Shade: se excluye el nativo del otro sistema. -->
        <opencv.otro.sistema>nu/pattern/opencv/windows/**</opencv.otro.sistema>
        <serial.otro.sistema>Windows/**</serial.otro.sistema>
        <hid.otro.sistema>win32-*/**</hid.otro.sistema>
        <jna.otro.sistema>com/sun/jna/win32-*/**</jna.otro.sistema>
        <javafx.otro.classifier>win</javafx.otro.classifier>
        <javafx.nativo.ajeno>**/*.dll</javafx.nativo.ajeno>
        <!-- USB de Zebra: un solo nativo por plataforma (Maven Central). -->
        <usb.nativo.classifier>linux-x86-64</usb.nativo.classifier>
        <zebra.dir>${project.basedir}/lib/zebra</zebra.dir>
    </properties>

    <dependencies>
        <!--
          SDK Zebra propietario: system solo para compilar.
          Se embebe en el JAR en prepare-package (shade no incluye scope system).
        -->
        <dependency>
            <groupId>com.zebra</groupId>
            <artifactId>ZSDK_CARD_API</artifactId>
            <version>3.01.263</version>
            <scope>system</scope>
            <systemPath>${zebra.dir}/ZSDK_CARD_API.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.zebra</groupId>
            <artifactId>ZSDK_API</artifactId>
            <version>3.01.263</version>
            <scope>system</scope>
            <systemPath>${zebra.dir}/ZSDK_API.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.zebra</groupId>
            <artifactId>barcode4j</artifactId>
            <version>zebra</version>
            <scope>system</scope>
            <systemPath>${zebra.dir}/barcode4j.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.zebra</groupId>
            <artifactId>snmp6_1z</artifactId>
            <version>1</version>
            <scope>system</scope>
            <systemPath>${zebra.dir}/snmp6_1z.jar</systemPath>
        </dependency>

        <!-- Transitive del Class-Path Zebra 3.01.263 (Maven Central → sí van al shade). -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <version>1.86</version>
        </dependency>
        <dependency>
            <groupId>commons-codec</groupId>
            <artifactId>commons-codec</artifactId>
            <version>1.17.1</version>
        </dependency>
        <dependency>
            <groupId>commons-io</groupId>
            <artifactId>commons-io</artifactId>
            <version>2.18.0</version>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>3.17.0</version>
        </dependency>
        <dependency>
            <groupId>commons-validator</groupId>
            <artifactId>commons-validator</artifactId>
            <version>1.9.0</version>
        </dependency>
        <dependency>
            <groupId>org.dom4j</groupId>
            <artifactId>dom4j</artifactId>
            <version>2.1.4</version>
        </dependency>
        <dependency>
            <groupId>jaxen</groupId>
            <artifactId>jaxen</artifactId>
            <version>2.0.0</version>
        </dependency>
        <dependency>
            <groupId>com.opencsv</groupId>
            <artifactId>opencsv</artifactId>
            <version>5.9</version>
        </dependency>
        <dependency>
            <groupId>org.simpleframework</groupId>
            <artifactId>simple-xml</artifactId>
            <version>2.7.1</version>
        </dependency>
        <dependency>
            <groupId>org.snmp4j</groupId>
            <artifactId>snmp4j</artifactId>
            <version>3.8.2</version>
        </dependency>

        <!-- USB: jar Java + un solo nativo (usb4java trae todos los classifiers por defecto). -->
        <dependency>
            <groupId>org.usb4java</groupId>
            <artifactId>usb4java</artifactId>
            <version>1.3.0</version>
            <exclusions>
                <exclusion>
                    <groupId>org.usb4java</groupId>
                    <artifactId>libusb4java</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.usb4java</groupId>
            <artifactId>libusb4java</artifactId>
            <version>1.3.0</version>
            <classifier>${usb.nativo.classifier}</classifier>
        </dependency>

        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-base</artifactId>
            <version>${javafx.version}</version>
            <classifier>${javafx.platform}</classifier>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-graphics</artifactId>
            <version>${javafx.version}</version>
            <classifier>${javafx.platform}</classifier>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
            <classifier>${javafx.platform}</classifier>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-swing</artifactId>
            <version>${javafx.version}</version>
            <classifier>${javafx.platform}</classifier>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.17.1</version>
        </dependency>
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>core</artifactId>
            <version>3.5.3</version>
        </dependency>
        <dependency>
            <groupId>org.openpnp</groupId>
            <artifactId>opencv</artifactId>
            <version>4.9.0-0</version>
        </dependency>
        <dependency>
            <groupId>com.fazecast</groupId>
            <artifactId>jSerialComm</artifactId>
            <version>2.11.0</version>
        </dependency>
        <dependency>
            <groupId>org.hid4java</groupId>
            <artifactId>hid4java</artifactId>
            <version>0.8.0</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <release>${java.version}</release>
                </configuration>
            </plugin>
            <!-- Embebe SDK Zebra (system) dentro de classes para que el shade lo lleve al ejecutable. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>embed-zebra-sdk</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <unzip dest="${project.build.outputDirectory}" overwrite="true" src="${zebra.dir}/ZSDK_CARD_API.jar"/>
                                <unzip dest="${project.build.outputDirectory}" overwrite="true" src="${zebra.dir}/ZSDK_API.jar"/>
                                <unzip dest="${project.build.outputDirectory}" overwrite="true" src="${zebra.dir}/barcode4j.jar"/>
                                <unzip dest="${project.build.outputDirectory}" overwrite="true" src="${zebra.dir}/snmp6_1z.jar"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <!-- *:* fuerza incluir también las system (Zebra SDK + deps). -->
                            <artifactSet>
                                <includes>
                                    <include>*:*</include>
                                </includes>
                                <excludes>
                                    <exclude>org.openjfx:*:*:${javafx.otro.classifier}</exclude>
                                </excludes>
                            </artifactSet>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                                <filter>
                                    <artifact>org.openjfx:*</artifact>
                                    <excludes>
                                        <exclude>${javafx.nativo.ajeno}</exclude>
                                    </excludes>
                                </filter>
                                <filter>
                                    <artifact>org.openpnp:opencv</artifact>
                                    <excludes>
                                        <exclude>nu/pattern/opencv/osx/**</exclude>
                                        <exclude>nu/pattern/opencv/linux/ARMv7/**</exclude>
                                        <exclude>nu/pattern/opencv/linux/ARMv8/**</exclude>
                                        <exclude>nu/pattern/opencv/linux/x86_32/**</exclude>
                                        <exclude>nu/pattern/opencv/windows/x86_32/**</exclude>
                                        <exclude>${opencv.otro.sistema}</exclude>
                                    </excludes>
                                </filter>
                                <filter>
                                    <artifact>com.fazecast:jSerialComm</artifact>
                                    <excludes>
                                        <exclude>OSX/**</exclude>
                                        <exclude>Solaris/**</exclude>
                                        <exclude>FreeBSD/**</exclude>
                                        <exclude>OpenBSD/**</exclude>
                                        <exclude>Android/**</exclude>
                                        <exclude>Linux/arm*/**</exclude>
                                        <exclude>Linux/ppc64le/**</exclude>
                                        <exclude>Linux/x86/**</exclude>
                                        <exclude>Windows/x86/**</exclude>
                                        <exclude>Windows/arm*/**</exclude>
                                        <exclude>Windows/aarch64/**</exclude>
                                        <exclude>${serial.otro.sistema}</exclude>
                                    </excludes>
                                </filter>
                                <filter>
                                    <artifact>org.hid4java:hid4java</artifact>
                                    <excludes>
                                        <exclude>darwin-*/**</exclude>
                                        <exclude>linux-arm/**</exclude>
                                        <exclude>linux-arm*/**</exclude>
                                        <exclude>linux-aarch64/**</exclude>
                                        <exclude>linux-riscv64/**</exclude>
                                        <exclude>linux-x86/**</exclude>
                                        <exclude>${hid.otro.sistema}</exclude>
                                    </excludes>
                                </filter>
                                <filter>
                                    <artifact>net.java.dev.jna:jna</artifact>
                                    <excludes>
                                        <exclude>com/sun/jna/darwin*/**</exclude>
                                        <exclude>com/sun/jna/aix-*/**</exclude>
                                        <exclude>com/sun/jna/freebsd-*/**</exclude>
                                        <exclude>com/sun/jna/openbsd-*/**</exclude>
                                        <exclude>com/sun/jna/sunos-*/**</exclude>
                                        <exclude>com/sun/jna/dragonflybsd-*/**</exclude>
                                        <exclude>${jna.otro.sistema}</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>mx.org.smsem.credencialessm.CredencialesMain</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>mx.org.smsem.credencialessm.CredencialesMain</mainClass>
                    <launcher>CredencialesSM</launcher>
                    <jlinkImageName>credencialessm-runtime</jlinkImageName>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>javafx-windows</id>
            <activation>
                <os><family>windows</family></os>
            </activation>
            <properties>
                <javafx.platform>win</javafx.platform>
                <opencv.otro.sistema>nu/pattern/opencv/linux/**</opencv.otro.sistema>
                <serial.otro.sistema>Linux/**</serial.otro.sistema>
                <hid.otro.sistema>linux-*/**</hid.otro.sistema>
                <jna.otro.sistema>com/sun/jna/linux-*/**</jna.otro.sistema>
                <javafx.otro.classifier>linux</javafx.otro.classifier>
                <javafx.nativo.ajeno>**/*.so</javafx.nativo.ajeno>
                <usb.nativo.classifier>win32-x86-64</usb.nativo.classifier>
            </properties>
        </profile>
        <profile>
            <id>javafx-mac</id>
            <activation>
                <os><family>mac</family></os>
            </activation>
            <properties>
                <javafx.platform>mac</javafx.platform>
            </properties>
        </profile>
        <!--
          Paquete liviano para la estación Windows (sin JRE embebido ni nativos de Linux).
          Incluye SDK Zebra + DLL USB + bat.

            mvn -Pwindows-dist -DskipTests clean package

          Resultado: target/CredencialesSM-windows.zip
        -->
        <profile>
            <id>windows-dist</id>
            <properties>
                <javafx.platform>win</javafx.platform>
                <opencv.otro.sistema>nu/pattern/opencv/linux/**</opencv.otro.sistema>
                <serial.otro.sistema>Linux/**</serial.otro.sistema>
                <hid.otro.sistema>linux-*/**</hid.otro.sistema>
                <jna.otro.sistema>com/sun/jna/linux-*/**</jna.otro.sistema>
                <javafx.otro.classifier>linux</javafx.otro.classifier>
                <javafx.nativo.ajeno>**/*.so</javafx.nativo.ajeno>
                <usb.nativo.classifier>win32-x86-64</usb.nativo.classifier>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>zip-windows</id>
                                <!-- Después del shade (también en package) para meter el JAR final. -->
                                <phase>verify</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <mkdir dir="${project.build.directory}/CredencialesSM-windows/CredencialesSM"/>
                                        <copy file="${project.build.directory}/${project.build.finalName}.jar"
                                              tofile="${project.build.directory}/CredencialesSM-windows/CredencialesSM/credencialessm-1.0.0-SNAPSHOT.jar"/>
                                        <copy file="${zebra.dir}/ZebraNativeUsbAdapter_64.dll"
                                              todir="${project.build.directory}/CredencialesSM-windows/CredencialesSM"/>
                                        <copy file="${zebra.dir}/ZebraNativeUsbAdapter_32.dll"
                                              todir="${project.build.directory}/CredencialesSM-windows/CredencialesSM"/>
                                        <echo file="${project.build.directory}/CredencialesSM-windows/CredencialesSM/CredencialesSM.bat"
                                              encoding="UTF-8"><![CDATA[@echo off
cd /d "%~dp0"
java -Dfile.encoding=UTF-8 -Djava.library.path=%~dp0 -jar credencialessm-1.0.0-SNAPSHOT.jar
if errorlevel 1 pause
]]></echo>
                                        <zip destfile="${project.build.directory}/CredencialesSM-windows.zip"
                                             basedir="${project.build.directory}/CredencialesSM-windows"/>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
